---
layout: base.njk
---
{% set active = site.defaultCategory or "all" %}
<div class="shell">

  <aside class="side">
    <a class="wordmark" href="/">{{ site.name }}<small>{{ site.role }}</small></a>

    {% if categories.length %}
    <div class="filter" role="group" aria-label="Filter work by category">
      {% for cat in categories %}
      <button type="button" data-cat="{{ cat.slug }}" aria-pressed="{{ "true" if cat.slug == active else "false" }}">{{ cat.label }}</button>
      {% endfor %}
    </div>
    {% endif %}

    <nav>
      <ul>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>

    <div class="foot">
      <span>&copy;{{ year }} {{ site.fullName }}</span>
    </div>
  </aside>

  <main class="main">
    <h1 class="sr-only">{{ site.fullName }} — {{ site.role }}</h1>

    <div class="gallery" id="grid">
      {% for item in gallery %}
      {%- set dim = dimensions[item.file] -%}
      <figure data-cat="{{ item.category }}" data-ar="{{ dim.ar if dim else 1 }}" style="--ar:{{ dim.ar if dim else 1 }}"{% if active != "all" and item.category != active %} hidden{% endif %}>
        <img src="images/{{ item.file }}" alt="{{ item.alt }}">
        <figcaption>
          <span>{{ item.title }}</span>
          <span>{% if item.credit %}{{ item.credit }}{% elif categories.length %}{{ item.category | capitalize }}{% endif %}</span>
        </figcaption>
      </figure>
      {% endfor %}
    </div>

    <p class="empty" id="empty" hidden>Nothing in this category yet.</p>

    <section class="panel" id="contact">
      <h2>Contact</h2>
      <p><a class="mail" href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      <p class="note">For bookings and rates. Please include dates, location, and the kind of work.</p>
    </section>

    {# On a phone the sidebar becomes a header, which would hoist the copyright
       above the photographs. It is repeated here and each copy is shown at
       only one breakpoint. #}
    <footer class="page-foot">&copy;{{ year }} {{ site.fullName }}</footer>
  </main>

</div>

{# Without JavaScript the filter can't be operated, so show everything rather
   than stranding the editorial work behind a button that does nothing. #}
<noscript>
  <style>
    .gallery figure[hidden] { display: block !important; }
    .filter { display: none; }
  </style>
</noscript>

<script src="/js/gallery.js" defer></script>
